<Application x:Class="VocalPracticeRecorder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- .NET 9 Fluent base (for ComboBox popups, ScrollBars, ContextMenus, ToolTips). -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ==================== Unified Studio Design Tokens ==================== -->

            <!-- Surfaces: cool matte graphite ramp -->
            <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#15181E" />
            <SolidColorBrush x:Key="SurfaceChromeBrush" Color="#1C1F26" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#232730" />
            <SolidColorBrush x:Key="SurfaceControlBrush" Color="#292E39" />
            <SolidColorBrush x:Key="SurfaceControlHoverBrush" Color="#323846" />
            <SolidColorBrush x:Key="SurfaceControlPressedBrush" Color="#222630" />
            <SolidColorBrush x:Key="SurfaceInputBrush" Color="#171A20" />

            <!-- Borders -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2C313D" />
            <SolidColorBrush x:Key="BorderControlBrush" Color="#39404F" />
            <SolidColorBrush x:Key="BorderControlHoverBrush" Color="#4D566A" />

            <!-- Typography -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA3B0" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#8C95A4" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#666F7E" />

            <!-- Brand Accent (default #E04B7A rose-peach aligned with app icon; live-updatable via ThemeManager) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#E04B7A" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#E5648D" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#BC3F66" />
            <SolidColorBrush x:Key="AccentSubtleBgBrush" Color="#28E04B7A" />
            <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#78E04B7A" />
            <SolidColorBrush x:Key="AccentSubtlePressedBrush" Color="#3AE04B7A" />
            <SolidColorBrush x:Key="AccentTextSoftBrush" Color="#F297B3" />

            <!-- Semantic Audio & Status Colors -->
            <SolidColorBrush x:Key="RecordBrush" Color="#E04F54" />
            <SolidColorBrush x:Key="RecordHoverBrush" Color="#EC6166" />
            <SolidColorBrush x:Key="RecordPressedBrush" Color="#C63E43" />
            <SolidColorBrush x:Key="VocalBrush" Color="#4AA3F0" />
            <SolidColorBrush x:Key="BackingBrush" Color="#967AE6" />
            <SolidColorBrush x:Key="FrameIdleBrush" Color="#3B9CF0" />
            <SolidColorBrush x:Key="PlayAccentBrush" Color="#E04B7A" />
            <SolidColorBrush x:Key="PlayAccentHoverBrush" Color="#E5648D" />
            <SolidColorBrush x:Key="PlayAccentPressedBrush" Color="#BC3F66" />
            <SolidColorBrush x:Key="PitchInTuneBrush" Color="#38C688" />
            <SolidColorBrush x:Key="PitchNearBrush" Color="#E8AE38" />
            <SolidColorBrush x:Key="PitchOffBrush" Color="#E45F64" />
            <SolidColorBrush x:Key="StarBrush" Color="#F2BE3B" />

            <!-- Override Fluent system theme brushes so Windows user accent colors never leak in -->
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1C1F26" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1C1F26" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#232730" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#262B35" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2F3542" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#21252E" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#323846" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#42495A" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9BA3B0" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E04B7A" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E5648D" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#BC3F66" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F297B3" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#E04B7A" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#E5648D" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#BC3F66" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#10FFFFFF" />

            <!-- ==================== Unified Control Styles ==================== -->

            <!-- Default Secondary Button: calm matte graphite, consistent across all windows -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceControlPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Brand Action Button (Play, Export, Confirm, OK — follows Dynamic AccentBrush) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hero Play/Pause Button -->
            <Style x:Key="HeroPlayButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- Record / Destructive Pill Button -->
            <Style x:Key="RecordPillButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RecordBrush}" />
                <Setter Property="BorderBrush" Value="#22FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource RecordHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource RecordPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact Quiet Secondary Tool Button -->
            <Style x:Key="GhostToolButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceControlPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Subtle Pill Toggle (Pitch overlay, 人声设置 drawer, 轻润色) -->
            <Style x:Key="SubtlePillToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtleBgBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextSoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtlePressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TopBar Live Pitch Pill Toggle -->
            <Style x:Key="PitchPillToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="94" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceControlHoverBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtleBgBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtlePressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TopBar Icon Buttons & Toggles -->
            <Style x:Key="TopIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#2CFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TopToggleButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtleBgBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtlePressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#2CFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource RecordBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource RecordPressedBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Audio Slider: background track, active fill, and thumb share exact center Y (0px vertical drift) -->
            <Style TargetType="Slider">
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="22" Background="Transparent" VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceControlBrush}" VerticalAlignment="Center" />
                                <Track x:Name="PART_Track" VerticalAlignment="Stretch">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{x:Null}" OverridesDefaultStyle="True" Command="Slider.DecreaseLarge" Focusable="False"
                                                      VerticalAlignment="Stretch" Background="{TemplateBinding Foreground}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Grid Background="Transparent">
                                                        <Border Height="4" CornerRadius="2,0,0,2" Background="{TemplateBinding Background}"
                                                                VerticalAlignment="Center" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{x:Null}" OverridesDefaultStyle="True" Command="Slider.IncreaseLarge" Focusable="False"
                                                      VerticalAlignment="Stretch">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Style="{x:Null}" OverridesDefaultStyle="True" Width="13" Height="13"
                                               VerticalAlignment="Center" BorderBrush="{TemplateBinding Foreground}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse x:Name="Dot" Width="13" Height="13" Fill="{StaticResource TextPrimaryBrush}"
                                                             Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Fill" Value="White" />
                                                            <Setter TargetName="Dot" Property="StrokeThickness" Value="2.4" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Dot" Property="Fill" Value="White" />
                                                            <Setter TargetName="Dot" Property="StrokeThickness" Value="2.8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio CheckBox -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderControlBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M3,8 L6.2,11.2 L12.5,4.2" Stroke="White" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio RadioButton -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Width="16" Height="16" Fill="{StaticResource SurfaceInputBrush}"
                                             Stroke="{StaticResource BorderControlBrush}" StrokeThickness="1.2" />
                                    <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio TextBox -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Inline Editable Song Title (invisible border at rest, subtle hint on hover, crisp Accent box while editing) -->
            <Style x:Key="InlineTitleTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BorderControlBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceInputBrush}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio ProgressBar -->
            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Border Background="{TemplateBinding Foreground}" CornerRadius="2" />
                                </Grid>
                                <Border x:Name="IndetBar" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                        Opacity="0.55" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="IndetBar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Sidebar Take ListBoxItem -->
            <Style x:Key="SidebarTakeItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="{TemplateBinding Margin}">
                                <Grid>
                                    <Border x:Name="AccentBar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,6,0,6"
                                            Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSubtleBgBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}" />
                                    <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
