<Window x:Class="VocalPracticeRecorder.Views.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理未标星录音" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource SurfaceChromeBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Padding="20,16,20,18">
        <StackPanel>
            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="选择要清理的范围" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="TotalSizeText" DockPanel.Dock="Right" FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <RadioButton x:Name="Days30" Content="30 天前未标星" GroupName="age" Margin="0,4" Checked="OnRangeChanged" />
                <RadioButton x:Name="Days14" Content="14 天前未标星" GroupName="age" Margin="0,4" IsChecked="True" Checked="OnRangeChanged" />
                <RadioButton x:Name="Days7" Content="7 天前未标星" GroupName="age" Margin="0,4" Checked="OnRangeChanged" />
                <RadioButton x:Name="DaysAll" Content="全部未标星" GroupName="age" Margin="0,4" Checked="OnRangeChanged" />
            </UniformGrid>

            <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="所有标星（★）作品会完整保留；清理的录音会移入系统回收站，可随时还原。"
                               FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostToolButton}" Padding="16,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="CleanButton" Content="移入回收站" Style="{StaticResource RecordPillButton}" Height="30"
                        Padding="16,0" Margin="8,0,0,0" Click="OnClean" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
