<Window x:Class="VocalPracticeRecorder.Views.PhoneShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码传到手机" Width="410" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Padding="20,16,20,18">
        <StackPanel>
            <TextBlock x:Name="FileNameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FileMetaText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,14" />

            <!-- Crisp white quiet-zone QR card -->
            <Border Background="White" CornerRadius="10" Padding="14" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Image x:Name="QrImage" Width="210" Height="210" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <!-- Adapter selector (shown only when >1 LAN IPv4 candidate exists) -->
            <DockPanel x:Name="AdapterRow" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Left" Text="网卡" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                <ComboBox x:Name="AdapterBox" Height="28" Padding="8,0,22,0" VerticalContentAlignment="Center" FontSize="12"
                          SelectionChanged="OnAdapterChanged" />
            </DockPanel>

            <!-- URL + Copy -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" Height="28"
                         VerticalContentAlignment="Center" Padding="8,0" />
                <Button x:Name="CopyUrlButton" Grid.Column="1" Content="复制链接" Style="{StaticResource GhostToolButton}"
                        Margin="6,0,0,0" Click="OnCopyUrl" />
            </Grid>

            <TextBlock x:Name="HintText" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                       Text="手机与电脑连同一 Wi-Fi，扫码即可下载（微信扫码点右上角「在浏览器打开」；关闭此窗口自动停止传输）。" />

            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource PitchInTuneBrush}" Text="等待手机扫码…" />
                <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource GhostToolButton}" Padding="16,0"
                        Click="OnClose" IsCancel="True" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
