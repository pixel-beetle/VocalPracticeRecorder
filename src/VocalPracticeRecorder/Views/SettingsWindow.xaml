<Window x:Class="VocalPracticeRecorder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <StackPanel Margin="24,16,24,20">
            <TextBlock Text="录音库位置" Style="{StaticResource SectionTitle}" Margin="0,4,0,4" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="更改…" Click="OnChangeRoot" />
                    <Button Content="打开" Click="OnOpenRoot" Margin="4,0,0,0" />
                </StackPanel>
                <TextBox x:Name="RootText" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="RootInfo" Margin="0,6,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" />

            <TextBlock Text="导出文件位置" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="更改…" Click="OnChangeExports" />
                    <Button Content="打开" Click="OnOpenExports" Margin="4,0,0,0" />
                    <Button x:Name="FollowButton" Content="跟随录音库" Click="OnFollowRoot" Margin="4,0,0,0"
                            ToolTip="导出到「录音库位置\Exports」" />
                </StackPanel>
                <TextBox x:Name="ExportsText" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>

            <TextBlock Text="录制画质" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="最高分辨率" VerticalAlignment="Center" Width="80" />
                <ComboBox x:Name="HeightBox" Width="140" SelectionChanged="OnQualityChanged" />
                <TextBlock Text="帧率" VerticalAlignment="Center" Margin="24,0,0,0" Width="40" />
                <ComboBox x:Name="FpsBox" Width="120" SelectionChanged="OnQualityChanged" />
            </StackPanel>

            <TextBlock Text="导出视频画质" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CrfBox" Width="244" SelectionChanged="OnQualityChanged" />
                <TextBlock Text="（音频固定 320 kbps）" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>

            <Button Content="关闭" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="88" Margin="0,24,0,0" Click="OnClose" />
        </StackPanel>

        <!-- Move progress -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#C0000000">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" Padding="24,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="正在移动…" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BusyProgress" Height="6" Minimum="0" Maximum="1" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
