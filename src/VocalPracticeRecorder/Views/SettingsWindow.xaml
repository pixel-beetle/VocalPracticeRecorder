<Window x:Class="VocalPracticeRecorder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <StackPanel Margin="22,14,22,18">
            <TextBlock Text="录音库" Style="{StaticResource SectionTitle}" Margin="0,2,0,4" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="更改…" Click="OnChangeRoot" />
                    <Button Content="打开" Click="OnOpenRoot" Margin="4,0,0,0" />
                </StackPanel>
                <TextBox x:Name="RootText" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="RootInfo" Margin="0,5,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />

            <TextBlock Text="导出位置" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="更改…" Click="OnChangeExports" />
                    <Button Content="打开" Click="OnOpenExports" Margin="4,0,0,0" />
                    <Button x:Name="FollowButton" Content="跟随录音库" Click="OnFollowRoot" Margin="4,0,0,0" />
                </StackPanel>
                <TextBox x:Name="ExportsText" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>

            <TextBlock Text="录制" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="HeightBox" Width="120" SelectionChanged="OnQualityChanged" ToolTip="最高分辨率" />
                <ComboBox x:Name="FpsBox" Width="110" Margin="8,0,0,0" SelectionChanged="OnQualityChanged" ToolTip="帧率" />
                <ComboBox x:Name="CrfBox" Width="190" Margin="8,0,0,0" SelectionChanged="OnQualityChanged" ToolTip="导出视频画质" />
            </StackPanel>

            <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" MinWidth="80" Margin="0,20,0,0" Click="OnClose" />
        </StackPanel>

        <!-- Inline move confirmation (never fights Z-order with OpenFolderDialog or Topmost windows) -->
        <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="#C8000000">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmDetail" Margin="0,8,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="移动过去" Style="{StaticResource AccentButtonStyle}" Click="OnConfirmMove" />
                        <Button Content="仅改位置" Margin="8,0,0,0" Click="OnConfirmKeep" />
                        <Button Content="取消" Margin="8,0,0,0" Click="OnConfirmCancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Move progress -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#C8000000">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="移动中…" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BusyProgress" Height="6" Minimum="0" Maximum="1" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
