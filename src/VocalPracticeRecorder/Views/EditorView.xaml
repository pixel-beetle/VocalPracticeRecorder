<UserControl x:Class="VocalPracticeRecorder.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:VocalPracticeRecorder.Editing"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="166" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video -->
        <Border Grid.Row="0" Background="Black" CornerRadius="6" ClipToBounds="True">
            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                          IsMuted="True" Stretch="Uniform" />
        </Border>

        <!-- Timeline -->
        <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="6" ClipToBounds="True">
            <ed:TimelineControl x:Name="Timeline" ToolTipService.InitialShowDelay="800" />
        </Border>

        <!-- Transport (single compact row) -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="PlayButton" Content="▶" Click="OnPlay" Width="46" ToolTip="播放 / 暂停 (Space)" />
            <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="10,0" FontFamily="Consolas" FontSize="14" Text="0:00.00" />
            <Button Content="[ 入点" Click="OnSetIn" Margin="4,0,0,0" ToolTip="设为开头 (I)" />
            <Button Content="出点 ]" Click="OnSetOut" Margin="4,0,0,0" ToolTip="设为结尾 (O)" />
            <Button Content="重置" Click="OnResetTrim" Margin="4,0,0,0" ToolTip="清除裁剪和删除" />
            <Button x:Name="DeleteSelButton" Content="✂ 删除" Click="OnDeleteSelection" Margin="10,0,0,0" IsEnabled="False"
                    ToolTip="删除拖动选出的片段 (Delete)；右键红色块恢复" />
            <Button x:Name="SplitButton" Content="拆分" Click="OnSplit" Margin="4,0,0,0"
                    ToolTip="在播放头处拆分为两个 take (S)" />
            <TextBlock x:Name="TrimText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Mix & alignment -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vocal alignment -->
            <StackPanel VerticalAlignment="Center" ToolTip="人声偏移：键盘 ← → ±10ms，Shift ±50ms">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−50" Click="OnNudge" Tag="-50" Style="{StaticResource IconButton}" />
                    <Button Content="−10" Click="OnNudge" Tag="-10" Style="{StaticResource IconButton}" Margin="3,0" />
                    <TextBlock x:Name="OffsetText" Width="64" TextAlignment="Center" VerticalAlignment="Center" FontSize="13.5"
                               FontFamily="Consolas" Text="0 ms" />
                    <Button Content="+10" Click="OnNudge" Tag="10" Style="{StaticResource IconButton}" Margin="3,0" />
                    <Button Content="+50" Click="OnNudge" Tag="50" Style="{StaticResource IconButton}" />
                    <Button Content="对齐" Click="OnAutoAlign" Margin="6,0,0,0" ToolTip="自动对齐" Padding="10,4" MinWidth="0" />
                    <Button x:Name="SuggestButton" Click="OnTrySuggestion" Margin="4,0,0,0" Padding="8,4" MinWidth="0" Visibility="Collapsed"
                            ToolTip="检测到的候选延迟，点一下试听，不对按 Ctrl+Z 撤销" />
                </StackPanel>
                <TextBlock x:Name="AlignBadge" Margin="2,4,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>

            <!-- Levels -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="人声" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource VocalBrush}" />
                <Slider x:Name="VocalGain" Grid.Column="1" Minimum="-24" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnGainChanged" Thumb.DragStarted="OnSliderDragStarted" />
                <TextBlock x:Name="VocalGainText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                <ComboBox x:Name="ChannelBox" Grid.Column="3" Margin="8,0,0,0" MinWidth="98" Height="28" Padding="8,0,22,0"
                          VerticalContentAlignment="Center" FontSize="12" SelectionChanged="OnChannelChanged" ToolTip="麦克风输入通道">
                    <ComboBoxItem Content="通道 1 (左)" />
                    <ComboBoxItem Content="通道 2 (右)" />
                    <ComboBoxItem Content="1+2 混合" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="伴奏" VerticalAlignment="Center" Margin="0,6,6,0" Foreground="{StaticResource BackingBrush}" />
                <Slider x:Name="BackingGain" Grid.Row="1" Grid.Column="1" Minimum="-30" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Margin="0,6,0,0" ValueChanged="OnGainChanged" Thumb.DragStarted="OnSliderDragStarted" />
                <TextBlock x:Name="BackingGainText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                <CheckBox x:Name="BackingMute" Grid.Row="1" Grid.Column="3" Content="静音" Margin="8,6,0,0"
                          Click="OnMuteChanged" ToolTip="不混入伴奏" />
            </Grid>
        </Grid>

        <!-- Export -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="KindVideo" Content="MP4" GroupName="kind" Margin="2,0,8,0" IsChecked="True" />
                    <RadioButton x:Name="KindMix" Content="混音 MP3" GroupName="kind" Margin="0,0,8,0" />
                    <RadioButton x:Name="KindDry" Content="干声 MP3" GroupName="kind" Margin="0,0,10,0" />
                    <Button x:Name="ExportButton" Content="导出" Click="OnExport" ToolTip="导出 (Ctrl+E)"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="RevealButton" Content="打开位置" Click="OnReveal" IsEnabled="False" />
                    <Button x:Name="CopyButton" Content="复制文件" Click="OnCopyFile" IsEnabled="False" Margin="6,0,0,0"
                            ToolTip="复制后直接 Ctrl+V 粘贴到微信" />
                </StackPanel>
                <Grid Margin="12,0" VerticalAlignment="Center">
                    <ProgressBar x:Name="ExportProgress" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="ExportText" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
