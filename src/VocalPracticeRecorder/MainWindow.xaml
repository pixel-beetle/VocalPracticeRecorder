<Window x:Class="VocalPracticeRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="练唱录制" Height="820" Width="1280" MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <CollectionViewSource x:Key="TakesView" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Library -->
        <DockPanel Grid.Column="0">
            <Button x:Name="NewRecordingButton" DockPanel.Dock="Top" Content="● 新录音" Margin="12,12,12,8"
                    HorizontalAlignment="Stretch" Style="{StaticResource RecordButton}" Click="OnNewRecording" />
            <TextBlock DockPanel.Dock="Top" Text="录音库（按曲目分组）" Style="{StaticResource SectionTitle}" Margin="14,4,0,4" />
            <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Margin="14,8" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="还没有录音。点「新录音」，框选 B 站视频区域就可以开始。" />
            <ListBox x:Name="TakesList" ItemsSource="{Binding Source={StaticResource TakesView}}" BorderThickness="0"
                     Background="Transparent" SelectionChanged="OnTakeSelected" Margin="4,0,4,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8,12,8,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, StringFormat={}{0} 遍}"
                                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="88" Height="50" CornerRadius="4" Background="#20000000" ClipToBounds="True" HorizontalAlignment="Left">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="{Binding Header, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding StarMark, Mode=OneWay}" Foreground="#FFC107" />
                                </TextBlock>
                                <TextBlock Text="{Binding TagLine}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重命名曲名…" Click="OnRename" />
                        <MenuItem Header="标为最佳 / 取消" Click="OnToggleStar" />
                        <MenuItem Header="打开所在文件夹" Click="OnOpenFolder" />
                        <Separator />
                        <MenuItem Header="删除这一遍（移到回收站）" Click="OnDelete" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- Record panel -->
        <ScrollViewer x:Name="RecordPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="新录音" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="框选视频区域 → 开始录制 → 到 B 站点播放跟唱 → 点控制条上的「停止」" Margin="0,6,0,8"
                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />

                <TextBlock Text="麦克风（输入设备）" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="MicBox" SelectionChanged="OnDeviceChanged" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock x:Name="MicFormatText" DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="8,0,0,0" />
                    <ProgressBar x:Name="MicMeter" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource VocalBrush}" />
                </DockPanel>

                <TextBlock Text="伴奏来源（录制这个输出设备播放的声音）" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="OutputBox" SelectionChanged="OnDeviceChanged" />
                <ProgressBar x:Name="BackMeter" Height="6" Minimum="0" Maximum="1" Margin="0,6,0,0" Foreground="{StaticResource BackingBrush}" />
                <TextBlock x:Name="DeviceError" Foreground="{StaticResource RecordBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

                <TextBlock Text="录制区域" Style="{StaticResource SectionTitle}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="框选区域" Click="OnSelectRegion" Margin="8,0,0,0" />
                    <TextBlock x:Name="RegionText" VerticalAlignment="Center" Text="未选择" />
                </DockPanel>
                <TextBlock x:Name="QualityText" Margin="0,6,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" />

                <Button x:Name="StartButton" Content="● 开始录制" Style="{StaticResource RecordButton}" HorizontalAlignment="Left"
                        Margin="0,28,0,0" Click="OnStartRecording" />
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                           Text="提示：开始录制后本窗口会最小化，控制条不会被录进视频。外放唱歌时程序会根据麦克风里的伴奏自动对齐人声；戴耳机时请在编辑器里用 ← → 微调一次，之后会自动记住。" />
            </StackPanel>
        </ScrollViewer>

        <!-- Editor host -->
        <ContentControl x:Name="EditorHost" Grid.Column="2" Visibility="Collapsed" Focusable="False" />

        <!-- Busy overlay -->
        <Grid x:Name="BusyOverlay" Grid.Column="2" Visibility="Collapsed" Background="#80000000">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" Padding="28,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="处理中…" FontSize="15" Margin="0,0,0,12" />
                    <ProgressBar IsIndeterminate="True" Height="4" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
